<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MusicActivity"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enjoy Music ..."
            android:textColor="@color/pink"
            android:textStyle="bold"
            android:textSize="25sp"
            android:layout_marginTop="10dp"
            android:padding="20dp"
            android:layout_gravity="left"
            />

        <ImageView
            android:id="@+id/ivmusiccenterphoto"
            android:layout_width="380dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp" />
        <TextView
            android:id="@+id/tvmusicplayersongname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tainu Khabar Nahi..."
            android:textColor="@color/pink"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="cursive"
            android:layout_marginTop="30dp"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="30dp">

            <TextView
                android:id="@+id/tvmusicplayerstarttime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Start Time"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_marginLeft="20dp" />

            <SeekBar
                android:id="@+id/sbmusicplayer"
                android:layout_width="0dp"
                android:backgroundTint="@color/pink"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                />
            <TextView
                android:id="@+id/tvmusicplayerendtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="End Time"
                android:textColor="@color/black"
                android:textSize="15sp"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="6"
            android:layout_marginTop="15dp"
            >
            <ImageView
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_skip_previous"
                android:layout_weight="1"
                android:id="@+id/ivmusicprevious"
                />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_replay"
                android:layout_weight="1"
                android:id="@+id/ivmusicbackward"
                />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_play"
                android:layout_weight="2"
                android:id="@+id/ivmusicpause"

                />

            <ImageView
                android:id="@+id/ivmusicforward"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:src="@drawable/icon_forward" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_skip_next"
                android:layout_weight="1"
                android:id="@+id/ivmusicnext"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:backgroundTint="@color/dark_pink"
                android:src="@drawable/icon_speaker"
                android:layout_margin="10dp"/>

            <SeekBar
                android:id="@+id/sbvolume"
                android:layout_width="150dp"
                android:backgroundTint="@color/blue"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>