<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MyProfileActivity"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/curve_bg"
        android:paddingTop="50sp">

        <androidx.cardview.widget.CardView
            android:id="@+id/profileCard"
            android:layout_width="175dp"
            android:layout_height="175dp"
            android:elevation="10dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="12dp"
            android:layout_marginLeft="130dp"
            android:layout_gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Profile Image (Circular) -->
            <ImageView
                android:id="@+id/ivAllCustomerProfileImage"
                android:layout_width="200dp"
                android:layout_height="240dp"
                android:src="@drawable/icon_person"
                android:scaleType="fitXY"
                android:layout_marginTop="-15dp"
                android:layout_gravity="center_horizontal"
                android:padding="8dp"/>


        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Delete User"
            android:id="@+id/btnAllCustomerDeleteUser"
            android:layout_marginTop="190dp"
            android:background="@color/yellow"
            android:layout_marginLeft="-180dp"/>






    </LinearLayout>

    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:id="@+id/ivUpdateProfile"
        android:src="@drawable/icon_edit"
        android:layout_marginTop="-50dp"
        android:layout_gravity="end"/>

    <!-- Username Text -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardElevation="15dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="6dp"
        android:layout_margin="6dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="@color/white">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Details"
            android:textColor="@color/blue2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="0dp"
            android:fontFamily="sans-serif"
            android:layout_gravity="center_horizontal"/>



        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp">

            <TextView
                android:id="@+id/tvAllCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:drawableLeft="@drawable/icon_person"
                android:drawablePadding="20dp"
                android:hint="Name"
                android:textSize="18dp"
                android:background="@drawable/et_bg_shape"
                android:layout_margin="20dp"
                android:textColor="@color/black"
                android:inputType="text"
                android:padding="16dp"
                android:textColorHint="@color/grey" />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="100dp">

            <TextView
                android:id="@+id/tvAllCustomerMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:drawableLeft="@drawable/icon_phone"
                android:drawablePadding="20dp"
                android:hint="Mobile"
                android:textSize="18dp"
                android:background="@drawable/et_bg_shape"
                android:layout_margin="20dp"
                android:textColor="@color/black"
                android:inputType="text"
                android:padding="16dp"
                android:textColorHint="@color/grey" />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="170dp">

            <TextView
                android:id="@+id/tvAllCustomerEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="93dp"
                android:drawableLeft="@drawable/icon_email"
                android:drawablePadding="20dp"
                android:hint="Email"
                android:textSize="18dp"
                android:background="@drawable/et_bg_shape"
                android:layout_margin="20dp"
                android:textColor="@color/black"
                android:inputType="number"
                android:padding="16dp"
                android:textColorHint="@color/grey" />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="240dp">

            <TextView
                android:id="@+id/tvAllCustomerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:drawableLeft="@drawable/icon_user"
                android:drawablePadding="20dp"
                android:hint="Address"
                android:background="@drawable/et_bg_shape"
                android:layout_margin="20dp"
                android:textSize="18dp"
                android:textColor="@color/black"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:textColorHint="@color/grey" />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="310dp">

            <TextView
                android:id="@+id/tvAllCustomerUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:drawableLeft="@drawable/icon_user"
                android:drawablePadding="20dp"
                android:hint="Username"
                android:background="@drawable/et_bg_shape"
                android:layout_margin="20dp"
                android:textSize="18dp"
                android:textColor="@color/black"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:textColorHint="@color/grey" />


        </com.google.android.material.textfield.TextInputLayout>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/SignOutGoogle"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/blue"
            android:text="SIGN OUT"
            android:layout_marginTop="450dp"
            android:drawableLeft="@drawable/google"
            android:textColor="@color/white"
            android:textStyle="bold" />





    </androidx.cardview.widget.CardView>










</LinearLayout>