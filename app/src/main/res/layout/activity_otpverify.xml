<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OTPVerifyActivity"
    android:background="@color/blue2"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:cardElevation="10dp"
        app:cardCornerRadius="70dp"
        android:layout_marginTop="20dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/vclobo"
            android:layout_marginTop="-5dp"
            android:layout_gravity="center_horizontal"/>


    </androidx.cardview.widget.CardView>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/golden_2"
        android:text="TATA CONNECT"
        android:layout_marginBottom="15dp"
        android:textStyle="bold"
        android:layout_marginTop="-8dp"
        android:textSize="20dp"
        android:gravity="center_horizontal"
        android:fontFamily="sans-serif-condensed-medium" />



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardElevation="12dp"
        android:layout_margin="2dp"
        app:cardCornerRadius="6dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="@color/white">


        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/otpicon"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OTP Verification"
            android:layout_marginTop="240dp"
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/rich_black"
            android:gravity="center_horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OTP is on registered mobile number"
            android:gravity="center_horizontal"
            android:layout_marginTop="270dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/registerNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9325633843"
            android:textStyle="bold"
            android:layout_marginTop="295dp"
            android:gravity="center_horizontal"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="350dp"
            android:gravity="center_horizontal">

            <EditText
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:id="@+id/etInputCode1"
                android:textColor="@color/rich_black"
                android:textSize="24sp"
                android:gravity="center"
                android:inputType="number"
                android:importantForAutofill="no"
                android:maxLength="1"
                android:imeOptions="actionNext"
                />

            <EditText
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:id="@+id/etInputCode2"
                android:textColor="@color/rich_black"
                android:textSize="24sp"
                android:inputType="number"
                android:gravity="center"
                android:layout_marginLeft="4dp"
                android:importantForAutofill="no"
                android:maxLength="1"
                android:imeOptions="actionNext"
                />

            <EditText
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:id="@+id/etInputCode3"
                android:textColor="@color/rich_black"
                android:textSize="24sp"
                android:inputType="number"
                android:gravity="center"
                android:layout_marginLeft="4dp"
                android:importantForAutofill="no"
                android:maxLength="1"
                android:imeOptions="actionNext"
                />

            <EditText
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:id="@+id/etInputCode4"
                android:textColor="@color/rich_black"
                android:textSize="24sp"
                android:inputType="number"
                android:gravity="center"
                android:layout_marginLeft="4dp"
                android:importantForAutofill="no"
                android:maxLength="1"
                android:imeOptions="actionNext"
                />
            <EditText
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:id="@+id/etInputCode5"
                android:textColor="@color/rich_black"
                android:textSize="24sp"
                android:inputType="number"
                android:gravity="center"
                android:layout_marginLeft="4dp"
                android:importantForAutofill="no"
                android:maxLength="1"
                android:imeOptions="actionNext"
                />
            <EditText
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:id="@+id/etInputCode6"
                android:textColor="@color/rich_black"
                android:textSize="24sp"
                android:gravity="center"
                android:inputType="number"
                android:layout_marginLeft="4dp"
                android:importantForAutofill="no"
                android:maxLength="1"
                android:imeOptions="actionDone"
                />


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginTop="410dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Didn't receive the OTP ?"
                android:textStyle="bold"
                android:layout_marginLeft="-180dp"
                android:gravity="center_horizontal"/>

            <TextView
                android:id="@+id/resendOtp"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Resend OTP"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:layout_marginLeft="-230dp"
                android:gravity="center_horizontal"/>



       </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/verifyBtn"
            android:layout_width="360dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/yellow"
            android:text="Verify"
            android:layout_marginTop="460dp"
            android:textColor="@color/black"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

























</LinearLayout>